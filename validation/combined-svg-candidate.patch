+import Base
+import ./svg.bend as SVG
+
+def many(n: Nat, +word: String, acc: String) -> String:
+  match n:
+    case Zero{}: acc
+    case Succ{d}: many(d, word, word ++ acc)
+
+def yes(b: Bool) -> IO(Unit):
+  IO.print(SVG.choose(String, b, "True", "False"))
+
+def main() -> IO(Unit):
+  +data = many(1024n, "0123456789abcdef0123456789abcdef", "")
+  +node = {SVG.Element{"svg", Con{SVG.Attr{"data", data}, Con{SVG.Attr{"tag", "&<>\"😀"}, Nil{}}}, Con{SVG.Element{"#text", Nil{}, Nil{}, data}, Nil{}}, ""} : SVG.Element}
+  +saved = SVG.serialize(node)
+  +suffix = SVG.drop(SVG.drop(saved, "<svg data=\""), data)
+  do IO<Unit>:
+    Unit <- IO.print(U32.show(SVG.length(saved)))
+    Unit <- yes(SVG.prefix(saved, "<svg data=\"0123456789abcdef"))
+    Unit <- yes(SVG.prefix(suffix, "\" tag=\"&amp;&lt;&gt;&quot;😀\">"))
+    Unit <- yes(SVG.string.equal(saved, saved))
+    Unit <- yes(Bool.not(SVG.string.equal(data, SVG.rev(SVG.rev(data, ""), "!"))))
+    yes(String.eq(SVG.drop(SVG.drop(suffix, "\" tag=\"&amp;&lt;&gt;&quot;😀\">"), data), "</svg>"))
+
