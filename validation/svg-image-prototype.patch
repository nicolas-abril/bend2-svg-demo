+# Decode XML entities before interpreting attributes or exposing source editing.
+def entity(+s: String) -> String:
+  branch(String, String.eq(s, "amp"), _ => "&",
+    _ => branch(String, String.eq(s, "lt"), _ => "<",
+      _ => branch(String, String.eq(s, "gt"), _ => ">",
+        _ => branch(String, String.eq(s, "quot"), _ => "\"",
+          _ => branch(String, String.eq(s, "apos"), _ => "'",
+            _ => branch(String, prefix(s, "#x"), _ => SCon{Chr{hex(drop(s, "#x"), 0)}, ""},
+              _ => branch(String, prefix(s, "#"), _ => SCon{Chr{F32.to_u32(scalar(drop(s, "#"), 65533.0))}, ""},
+                _ => "&" ++ s ++ ";")))))))
+
+def entities.more(scan: Scan, acc: String, next: String -> String -> String) -> String:
+  Scan{h, t} = scan
+  next(t)(rev(entity(h), acc))
+
+@unsafe
+def entities.loop(s: String, +acc: String) -> String:
+  match s:
+    case SNil{}: rev(acc, "")
+    case SCon{Chr{c}, t}:
+      +ch = c
+      +tail = t
+      branch(String, U32.is_eq(ch, 38),
+        _ => entities.more(until(tail, 59, ""), acc, rest => text => entities.loop(rest, text)),
+        _ => entities.loop(tail, SCon{Chr{ch}, acc}))
+
+def entities(s: String) -> String:
+  entities.loop(s, "")
+
+def decode.attrs(as: List<&2, Attr>) -> List<&2, Attr>:
+  match as:
+    case Nil{}: Nil{}
+    case Con{Attr{k, v}, rest}: Con{Attr{k, entities(v)}, decode.attrs(rest)}
+
+def decode.nodes(xs: List<&2, Element>) -> List<&2, Element>:
+  match xs:
+    case Nil{}: Nil{}
+    case Con{Element{n, as, kids, txt}, rest}:
+      Con{Element{n, decode.attrs(as), decode.nodes(kids), entities(txt)}, decode.nodes(rest)}
+
+def parse(s: String) -> Element:
+  tree.root(decode.nodes(tree(annotate(tokenize(s), 1), Con{Element{"#document", Nil{}, Nil{}, ""}, Nil{}})))
+
