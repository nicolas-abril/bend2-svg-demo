+def filter.blend.lum(c: Color) -> F32:
+  Color{r, g, b, a} = c
+  (0.3 * r + 0.59 * g + 0.11 * b : F32)
+
+def filter.blend.sat(+c: Color) -> F32:
+  Color{r, g, b, a} = c
+  (max(r, max(g, b)) - min(r, min(g, b)) : F32)
+
+def filter.blend.setsat(+c: Color, +s: F32) -> Color:
+  Color{r, g, b, a} = c
+  +lo = min(r, min(g, b))
+  +span = (max(r, max(g, b)) - lo : F32)
+  +scale = choose(F32, F32.is_gt(span, 0.0), (s / max(span, 0.0000001) : F32), 0.0)
+  Color{((r - lo) * scale : F32), ((g - lo) * scale : F32), ((b - lo) * scale : F32), 1.0}
+
+def filter.blend.clip.scale(c: Color, +l: F32, +scale: F32) -> Color:
+  Color{r, g, b, a} = c
+  Color{(l + (r - l) * scale : F32), (l + (g - l) * scale : F32), (l + (b - l) * scale : F32), 1.0}
+
+def filter.blend.clip(+c: Color) -> Color:
+  Color{r, g, b, a} = c
+  +l = filter.blend.lum(c)
+  +lo = min(r, min(g, b))
+  +hi = max(r, max(g, b))
+  +scaleLow = choose(F32, F32.is_lt(lo, 0.0), (l / max(0.0000001, (l - lo : F32)) : F32), 1.0)
+  +scaleHigh = choose(F32, F32.is_gt(hi, 1.0), ((1.0 - l) / max(0.0000001, (hi - l : F32)) : F32), 1.0)
+  filter.blend.clip.scale(c, l, (scaleLow * scaleHigh : F32))
+
+def filter.blend.setlum(+c: Color, l: F32) -> Color:
+  Color{r, g, b, a} = c
+  +delta = (l - filter.blend.lum(c) : F32)
+  filter.blend.clip(Color{(r + delta : F32), (g + delta : F32), (b + delta : F32), 1.0})
+
+def filter.blend.rgb(+a: Color, +b: Color, +kind: U32) -> Color:
+  Color{ar, ag, ab, aa} = a
+  Color{br, bg, bb, ba} = b
+  branch(Color, U32.is_eq(kind, 12), _ => filter.blend.setlum(filter.blend.setsat(a, filter.blend.sat(b)), filter.blend.lum(b)),
+    _ => branch(Color, U32.is_eq(kind, 13), _ => filter.blend.setlum(filter.blend.setsat(b, filter.blend.sat(a)), filter.blend.lum(b)),
