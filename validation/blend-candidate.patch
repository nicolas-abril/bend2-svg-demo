+    case 4: max(a, b)
+    case 5: filter.blend.hard(b, a)
+    case 6: choose(F32, F32.is_le(b, 0.0), 0.0, choose(F32, F32.is_ge(a, 1.0), 1.0, min(1.0, (b / max(0.0000001, (1.0 - a : F32)) : F32))))
+    case 7: choose(F32, F32.is_ge(b, 1.0), 1.0, choose(F32, F32.is_le(a, 0.0), 0.0, (1.0 - min(1.0, ((1.0 - b) / max(0.0000001, a) : F32)) : F32)))
+    case 8: filter.blend.hard(a, b)
+    case 9: filter.blend.soft(a, b)
+    case 10: F32.abs((a - b : F32))
