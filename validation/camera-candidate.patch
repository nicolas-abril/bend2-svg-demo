+def equal(source: String, body: String) -> String:
+  SVG.choose(String, SVG.string.equal(Editor.frame(Editor.load(source, 64, 64)), SVG.ppm(64, 64, SVG.document(SVG.parse("<svg>" ++ body ++ "</svg>"), 64.0, 64.0), 4)), "PASS", "FAIL")
